OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
DATABASE_URL=sqlite:///./reviews.db
NEGATIVE_ALERT_THRESHOLD=2
# Set to true to bypass the real OpenRouter call and use a local heuristic
# (useful offline, or in a sandbox that blocks outbound calls to openrouter.ai)
USE_MOCK_LLM=false
