OPENROUTER_API_KEY=your_openrouter_api_key_here
# Must be a vision-capable model on OpenRouter (accepts image inputs)
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# Set to true to bypass the real OpenRouter vision call and use a local
# color-heuristic mock instead (useful offline, or in a sandbox that blocks
# outbound calls to openrouter.ai). The mock CANNOT identify plant species -
# it only estimates health from color statistics, for testing the app flow.
USE_MOCK_LLM=false
